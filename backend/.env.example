# Copy this file to .env in the project root and replace placeholders.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MYSQL_DSN=mysql+asyncmy://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/product_agent
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAILS=[]
CHROMA_PERSIST_DIRECTORY=data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=512
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
CRAWLER_DOMAINS=[]


# Optional web search; never commit an actual key
TAVILY_API_KEY=
WEB_SEARCH_CACHE_HOURS=6
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_CALLS=2

# Label for response metrics and optimization comparisons
TIMING_LABEL=baseline-20261013
